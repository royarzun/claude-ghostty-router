#!/usr/bin/env bash
# claude-account — inspeccion y control del enrutado de cuentas Claude.
set -u

# Se instala como symlink en ~/.local/bin, y macOS no tiene `readlink -f`:
# hay que seguir la cadena a mano para encontrar las librerias del repo.
car_self="${BASH_SOURCE[0]}"
while [ -L "$car_self" ]; do
  car_link_dir="$(cd "$(dirname "$car_self")" && pwd)"
  car_self="$(readlink "$car_self")"
  case "$car_self" in
    /*) ;;
    *) car_self="$car_link_dir/$car_self" ;;
  esac
done
CAR_ROOT_DIR="$(cd "$(dirname "$car_self")/.." && pwd)"

. "$CAR_ROOT_DIR/lib/config.sh"
. "$CAR_ROOT_DIR/lib/resolve.sh"
. "$CAR_ROOT_DIR/lib/identity.sh"
. "$CAR_ROOT_DIR/lib/badge.sh"

CAR_CONF="${CAR_CONF:-$HOME/.config/claude-ghostty-router/routes.conf}"

# statusline
# Lee por stdin el JSON de estado que entrega Claude Code y escribe la linea
# del badge. Nunca falla ni bloquea: informa de la cuenta con la que la sesion
# ESTA corriendo, no de la que le tocaria. Por eso el perfil sale del
# CLAUDE_CONFIG_DIR heredado del proceso claude y no de resolver la carpeta:
# si alguien esquiva la funcion del shell con `command claude`, el badge lo
# delata en vez de repetir la version oficial de los hechos.
cmd_statusline() {
  local config_dir default_dir i profile color identity datos project label email
  local payload=""

  # Claude Code escribe el JSON en nuestro stdin. Se lee entero y de una vez,
  # antes de decidir nada: un camino que salga sin leerlo le devuelve un EPIPE
  # a quien lo esta escribiendo. `read -d ""` lee hasta EOF sin forkar.
  IFS= read -r -d "" payload || true

  default_dir="$CAR_HOME/.claude"
  config_dir="$(car_strip_trailing_slash "${CLAUDE_CONFIG_DIR:-$default_dir}")"
  # routes.conf guarda las rutas ya resueltas (cd -P), asi que el config-dir
  # heredado tiene que llegar a esa misma forma o no casaria ningun perfil.
  config_dir="$(cd -P "$config_dir" 2>/dev/null && pwd || printf '%s' "$config_dir")"

  if ! car_load_config "$CAR_CONF" 2>/dev/null; then
    # Aqui reaparece el aviso de config rota: es la unica superficie que le
    # queda al proyecto, y `_launch-check` ya explica el error por stderr.
    printf '%s\n' "⚠ routes.conf invalido"
    return 0
  fi

  profile="?"
  color="-"
  for ((i = 0; i < ${#CAR_P_DIR[@]}; i++)); do
    if [ "${CAR_P_DIR[$i]}" = "$config_dir" ]; then
      profile="${CAR_P_NAME[$i]}"
      color="${CAR_P_COLOR[$i]}"
      break
    fi
  done

  if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$(badge_color "$profile" "$color") · (sin python3)"
    return 0
  fi

  identity="$(identity_file "$config_dir")" || identity=""
  # Un solo fork: statusline.py saca la carpeta del JSON de stdin y el email
  # del perfil de una sola vez. Claude Code reejecuta esto con cada mensaje.
  datos="$(python3 "$CAR_ROOT_DIR/lib/statusline.py" "$identity" <<< "$payload")"
  # Separador US y no tabulador: el tabulador es espacio en blanco para el IFS,
  # y una carpeta vacia (stdin sin JSON valido) desplazaria el email a su sitio.
  IFS=$'\037' read -r project email <<< "$datos"

  label="${project##*/}"
  [ -n "$email" ] || email="(sin sesion)"

  printf '%s · %s' "$(badge_color "$profile" "$color")" "$(badge_sanitize "$email")"
  [ -n "$label" ] && printf ' · %s' "$(badge_sanitize "$label")"
  printf '\n'
  return 0
}

# _config-dirs
# Un config-dir por linea, en orden de declaracion. Existe para que install.sh
# sepa en que settings.json escribir sin reimplementar el parseo de routes.conf.
cmd_config_dirs() {
  car_load_config "$CAR_CONF" || return $CAR_ECONFIG
  local i
  for ((i = 0; i < ${#CAR_P_DIR[@]}; i++)); do
    printf '%s\n' "${CAR_P_DIR[$i]}"
  done
}

# _launch-check <directorio>
# Exito: imprime el config-dir verificado (o nada si no hay routes.conf).
# Fallo: explica en stderr y devuelve el codigo del motivo. Sin excepciones:
# si no se puede verificar, no se arranca.
# Los CAR_* que se devuelven vienen de lib/config.sh (siempre enteros); este
# archivo se analiza aislado y no se ve ese origen, por eso cada
# `return $CAR_*` sin comillas se marca como sospechoso.
# shellcheck disable=SC2086
cmd_launch_check() {
  local dir="${1:-$PWD}" record profile label config_dir glob color tint email status default_dir

  [ -f "$CAR_CONF" ] || return 0

  car_load_config "$CAR_CONF" || return $CAR_ECONFIG
  record="$(resolve_route "$dir")" || return $CAR_ECONFIG
  # color y tint no se usan en esta ruta: solo hacen falta para pintar.
  # shellcheck disable=SC2034
  IFS=$'\t' read -r profile label config_dir glob color tint <<< "$record"

  # Claude Code usa dos layouts distintos segun CLAUDE_CONFIG_DIR este o no
  # puesta: sin ella, los datos viven en ~/.claude/ pero la config principal
  # es el hermano ~/.claude.json; con ella puesta a <dir>, la config principal
  # pasa a ser <dir>/.claude.json, DENTRO del directorio (ver
  # docs/experiments/2026-09-01-identity-layout.md). Cuando el perfil resuelto
  # es justo el que Claude Code usaria sin ninguna variable, exportarla de
  # todos modos le esconderia al usuario su propio ~/.claude.json de toda la
  # vida, con proyectos, MCP e historial reales, como si el perfil fuera
  # nuevo. Por eso aqui no se imprime nada: router.zsh ya sabe arrancar
  # `claude` a secas cuando _launch-check no imprime config-dir.
  default_dir="$(car_strip_trailing_slash "$CAR_HOME/.claude")"

  if [ "$glob" = "-" ]; then
    [ "$config_dir" = "$default_dir" ] || printf '%s' "$config_dir"
    return 0
  fi

  email="$(identity_email "$config_dir")"
  status=$?
  if [ $status -ne 0 ]; then
    echo "claude-account: no arranco Claude en $label (perfil '$profile')." >&2
    echo "  Arregla la sesion con: claude-account login $profile" >&2
    return $status
  fi

  if ! identity_matches "$email" "$glob"; then
    echo "claude-account: cuenta equivocada para $label (perfil '$profile')." >&2
    echo "  esperaba: $glob" >&2
    echo "  logueada: $email" >&2
    echo "  Arreglalo con: claude-account login $profile" >&2
    return $CAR_EMISMATCH
  fi

  [ "$config_dir" = "$default_dir" ] || printf '%s' "$config_dir"
  return 0
}

cmd_which() {
  local dir="${1:-$PWD}" record profile label pdir pglob color tint
  car_load_config "$CAR_CONF" || return $CAR_ECONFIG
  record="$(resolve_route "$dir")" || return $CAR_ECONFIG
  # shellcheck disable=SC2034
  IFS=$'\t' read -r profile label pdir pglob color tint <<< "$record"
  printf '%s\n' "$profile"
}

cmd_routes() {
  local i
  car_load_config "$CAR_CONF" || return $CAR_ECONFIG
  if [ "${#CAR_R_PATH[@]}" -eq 0 ]; then
    echo "(sin rutas: todo cae en el perfil por defecto '${CAR_P_NAME[0]}')"
    return 0
  fi
  for ((i = 0; i < ${#CAR_R_PATH[@]}; i++)); do
    printf '%-50s %s\n' "${CAR_R_PATH[$i]}" "${CAR_R_PROFILE[$i]}"
  done
}

cmd_status() {
  local i email status record profile here pdir pglob color tint

  car_load_config "$CAR_CONF" || return $CAR_ECONFIG

  echo "Perfiles:"
  for ((i = 0; i < ${#CAR_P_NAME[@]}; i++)); do
    email="$(identity_email "${CAR_P_DIR[$i]}" 2>/dev/null)"
    status=$?
    if [ $status -eq 0 ]; then
      printf '  %-10s %-40s %s\n' "${CAR_P_NAME[$i]}" "${CAR_P_DIR[$i]}" "$email"
    else
      printf '  %-10s %-40s %s\n' "${CAR_P_NAME[$i]}" "${CAR_P_DIR[$i]}" "(sin sesion)"
    fi
  done

  record="$(resolve_route "$PWD")" || return $CAR_ECONFIG
  # shellcheck disable=SC2034
  IFS=$'\t' read -r profile here pdir pglob color tint <<< "$record"
  echo
  echo "Directorio actual: $here -> perfil '$profile'"
}

cmd_login() {
  local name="${1:-}" index dir
  if [ -z "$name" ]; then
    echo "claude-account: uso: claude-account login <perfil>" >&2
    return $CAR_ECONFIG
  fi
  car_load_config "$CAR_CONF" || return $CAR_ECONFIG
  if ! index="$(car_profile_index "$name")"; then
    echo "claude-account: no existe el perfil '$name' en $CAR_CONF" >&2
    return $CAR_ECONFIG
  fi
  dir="${CAR_P_DIR[$index]}"
  mkdir -p "$dir"
  echo "claude-account: abriendo Claude en el perfil '$name' ($dir)."
  echo "  Dentro, ejecuta /login para iniciar sesion. Luego sal con /exit."
  # Unico camino que no verifica, y tiene que serlo: su proposito es crear la
  # sesion que despues se verifica. Un perfil vacio nunca podria loguearse.
  CLAUDE_CONFIG_DIR="$dir" command claude
}

cmd_help() {
  cat <<'AYUDA'
claude-account — enrutado de cuentas Claude por carpeta, dentro de Ghostty

  claude-account                estado de los perfiles y del directorio actual
  claude-account routes         mapa carpeta -> perfil
  claude-account which [dir]    perfil de un directorio
  claude-account check          diagnostico completo
  claude-account login <perfil> inicia sesion en un perfil
  claude-account statusline     linea del badge (la invoca Claude Code)
AYUDA
}

car_check_ok=0
car_check_bad=0

car_ok()   { printf '  ok   %s\n' "$1"; car_check_ok=$((car_check_ok + 1)); }
car_fail() { printf '  FALLA %s\n' "$1"; car_check_bad=$((car_check_bad + 1)); }

cmd_check() {
  local i j email status expires now dias creds settings

  car_check_ok=0
  car_check_bad=0

  echo "Configuracion"
  if car_load_config "$CAR_CONF" 2>/dev/null; then
    car_ok "routes.conf valido (${#CAR_P_NAME[@]} perfiles, ${#CAR_R_PATH[@]} rutas)"
  else
    car_fail "routes.conf invalido o ausente: $CAR_CONF"
    car_load_config "$CAR_CONF"
    return 1
  fi

  echo "Sesion"
  if [ -n "${CAR_ROUTER_LOADED:-}" ]; then
    car_ok "el router esta cargado en esta shell"
  else
    car_fail "el router no esta cargado en esta shell (abre un tab nuevo, o revisa ~/.zshrc)"
  fi

  echo "Perfiles"
  for ((i = 0; i < ${#CAR_P_NAME[@]}; i++)); do
    email="$(identity_email "${CAR_P_DIR[$i]}" 2>/dev/null)"
    status=$?
    if [ $status -ne 0 ]; then
      car_fail "${CAR_P_NAME[$i]}: sin sesion -> claude-account login ${CAR_P_NAME[$i]}"
      continue
    fi
    if identity_matches "$email" "${CAR_P_GLOB[$i]}"; then
      car_ok "${CAR_P_NAME[$i]}: $email"
    else
      car_fail "${CAR_P_NAME[$i]}: $email no coincide con ${CAR_P_GLOB[$i]}"
    fi

    creds="${CAR_P_DIR[$i]}/.credentials.json"
    if [ -f "$creds" ] && expires="$(python3 "$CAR_ROOT_DIR/lib/expiry.py" "$creds" 2>/dev/null)"; then
      now=$(( $(date +%s) * 1000 ))
      if [ "$expires" -lt "$now" ]; then
        echo "       (token vencido; Claude lo renovara al arrancar)"
      else
        dias=$(( (expires - now) / 86400000 ))
        [ "$dias" -le 3 ] && echo "       (el token vence en $dias dias)"
      fi
    fi
  done

  echo "Badge"
  for ((i = 0; i < ${#CAR_P_NAME[@]}; i++)); do
    settings="${CAR_P_DIR[$i]}/settings.json"
    python3 "$CAR_ROOT_DIR/lib/settings.py" "$settings" --check
    case $? in
      0) car_ok "${CAR_P_NAME[$i]}: statusLine instalado" ;;
      2) car_fail "${CAR_P_NAME[$i]}: sin statusLine en $settings -> ./install.sh" ;;
      3) car_fail "${CAR_P_NAME[$i]}: hay otro statusLine en $settings; no lo toco" ;;
      *) car_fail "${CAR_P_NAME[$i]}: no puedo leer $settings" ;;
    esac
  done

  for ((i = 0; i < ${#CAR_P_NAME[@]}; i++)); do
    for ((j = i + 1; j < ${#CAR_P_NAME[@]}; j++)); do
      local a b
      a="$(identity_email "${CAR_P_DIR[$i]}" 2>/dev/null)" || continue
      b="$(identity_email "${CAR_P_DIR[$j]}" 2>/dev/null)" || continue
      if [ "$a" = "$b" ]; then
        car_fail "${CAR_P_NAME[$i]} y ${CAR_P_NAME[$j]} usan la misma cuenta ($a)"
      fi
    done
  done

  echo
  echo "$car_check_ok en orden, $car_check_bad por arreglar"
  [ "$car_check_bad" -eq 0 ]
}

main() {
  local command="${1:-status}"
  shift || true
  case "$command" in
    statusline)    cmd_statusline "$@" ;;
    _config-dirs)  cmd_config_dirs "$@" ;;
    _launch-check) cmd_launch_check "$@" ;;
    which)         cmd_which "$@" ;;
    routes)        cmd_routes "$@" ;;
    status)        cmd_status "$@" ;;
    login)         cmd_login "$@" ;;
    check)         cmd_check "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      echo "claude-account: comando desconocido '$command'" >&2
      return 1
      ;;
  esac
}

main "$@"
